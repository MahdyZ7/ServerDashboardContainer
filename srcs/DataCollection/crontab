# DataCollection Backend Scheduled Tasks
# Format: minute hour day month weekday command
# run-collection.sh <job> loads the container environment safely and skips a
# job while its previous run is still active (one lock per job name).

PATH=/usr/local/bin:/usr/bin:/bin

# Collect server metrics every 15 minutes
*/15 * * * * /app/run-collection.sh metrics COLLECT_DISK_USAGE=false RUN_CLEANUP=false >> /var/log/datacollection.log 2>&1

# Collect disk usage data once per day at 23:17 (can run for hours; separate lock)
17 23 * * * /app/run-collection.sh disk COLLECT_DISK_USAGE=true RUN_CLEANUP=false >> /var/log/datacollection.log 2>&1

# Run data retention cleanup weekly on Sundays at 23:05 (cleanup only, no collection)
5 23 * * 0 /app/run-collection.sh cleanup CLEANUP_ONLY=true >> /var/log/datacollection.log 2>&1

# License pool snapshot every 5 minutes (needs LICENSE_QUERY_SERVER; see backend.read_license_config)
*/5 * * * * /app/run-collection.sh licenses LICENSES_ONLY=true >> /var/log/datacollection.log 2>&1
